APP_ORIGIN=http://localhost:3000
# Worker-to-web calls stay local when APP_ORIGIN is a public HTTPS tunnel.
WORKER_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Local preview only. Production requires DATABASE_URL, S3 and HTTPS.
LOCAL_PREVIEW=true
DEMO_MODE=true
DATABASE_URL=
WORKER_TOKEN=
WECOM_TEAM_ID=
WECOM_BOT_ID=
WECOM_BOT_SECRET=
AI_BASE_URL=https://api.deepseek.com
# DeepSeek V4.1 Flash: https://www.deepseek.com/en/news/deepseek-v4-1-flash/
# Use the exact model name published by your provider. No automatic fallback.
AI_MODEL=deepseek-flash
AI_API_KEY=
# Images are always private task attachments and are never sent to AI.
# ClientCore’s scoped integration endpoint; do not use a browser session token here.
CLIENTCORE_KANBAN_API_BASE_URL=http://127.0.0.1:5174/api/integrations/team-kanban/
CLIENTCORE_KANBAN_API_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Separate Supabase connection for shared insurance comparisons. Server only.
# Use the dedicated kanban_quotes_app role; omit sslmode parameters (CA verified in code).
INSURANCE_DATABASE_URL=
INSURANCE_DATABASE_CA=config/supabase-ca.crt

# First-party Housekeeper unified login; generated secret is server-only.
HOUSEKEEPER_SSO_ORIGIN=
HOUSEKEEPER_SSO_SECRET=
