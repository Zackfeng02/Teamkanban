{
  "name": "team-kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "preflight": "node src/preflight/cli.ts",
    "demo": "node src/preflight/cli.ts inspect fixtures/merged-record.json --media fixtures/media.json",
    "gate": "node src/preflight/cli.ts gate evidence/acceptance.json",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file=.env.local src/worker.ts",
    "recover-password": "node --env-file=.env.local scripts/recover-password.ts",
    "bootstrap": "node --env-file=.env.local scripts/bootstrap.ts",
    "ai:verify": "node --env-file=.env.local scripts/verify-ai.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1129.0",
    "@electric-sql/pglite": "0.5.8",
    "@wecom/aibot-node-sdk": "1.0.7",
    "lucide": "1.43.0",
    "lucide-react": "1.43.0",
    "morphicons": "1.7.1",
    "next": "16.3.4",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
